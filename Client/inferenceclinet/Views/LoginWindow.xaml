<Window x:Class="inferenceclinet.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="로그인" Height="380" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="소비자 로그인" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="아이디" Margin="0,0,0,4"/>
        <TextBox x:Name="IdTextBox" Height="28" Margin="0,0,0,16"/>

        <TextBlock Text="비밀번호" Margin="0,0,0,4"/>
        <PasswordBox x:Name="LoginPasswordBox" Height="28" Margin="0,0,0,20"/>

        <Button x:Name="LoginButton" Content="로그인" Height="34" Click="OnLoginClick" IsDefault="True"/>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
