<Window x:Class="inferenceclinet.Views.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검사 모니터" Height="560" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="CamPlaceholderText" Text="Cam" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="CamImage" Stretch="Uniform"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="StopButton" Content="중지" Width="80" Height="30" Margin="0,0,8,0" Click="OnStopClick"/>
                <Button x:Name="AnalyzeButton" Content="분석" Width="80" Height="30" Click="OnAnalyzeClick"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="경과" FontWeight="Bold"/>
            <TextBlock x:Name="ElapsedText" Text="00:00:00" Margin="0,0,0,12"/>

            <TextBlock Text="불량유무" FontWeight="Bold"/>
            <TextBlock x:Name="DefectStatusText" Text="-" Margin="0,0,0,12"/>

            <TextBlock Text="검사이력" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid x:Name="HistoryGrid" Height="260" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="OnHistoryRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="*"/>
                    <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="*"/>
                    <DataGridTextColumn Header="신뢰도" Binding="{Binding Confidence}" Width="*"/>
                    <DataGridTextColumn Header="형번" Binding="{Binding DefectType}" Width="*"/>
                    <DataGridTextColumn Header="Box(x1,y1,x2,y2)" Binding="{Binding Box}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
